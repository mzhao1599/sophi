# Copy to .env.local (git-ignored) and fill in. Names only here: never commit a value.
# On Vercel, set the same names under Project Settings > Environment Variables (see README.md).

# ---- Onboarding engine (server only) ----
# Empty: the onboarding agent runs when ANTHROPIC_API_KEY is set, the fixed questions when it isn't.
# "deterministic" forces the fixed questions; "agent" warns in the server log when the key is missing.
ONBOARDING_ENGINE=
# Claude, for the onboarding agent and every walker turn.
ANTHROPIC_API_KEY=
# Optional Claude model override. Leave empty for the default in services/cloud-api/src/onboarding/anthropic.ts.
ONBOARDING_AGENT_MODEL=

# ---- Supabase (sessions in Postgres) ----
# Set all three, or none for the in-memory demo store. Some but not all stops onboarding from starting.
# Local values: `pnpm supabase start`, then `pnpm supabase status` prints API_URL, PUBLISHABLE_KEY and SECRET_KEY.
# Hosted values: the Supabase dashboard, Project Settings > API Keys.
# Project URL. Public: also sent to the browser.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…, or the legacy anon key). Public: row-level security is what protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…, or the legacy service_role key). Server only, never NEXT_PUBLIC_: it bypasses
# row-level security. Used only to reach demo sessions by their token hash, and to delete an account when
# its signed-in owner asks.
SUPABASE_SECRET_KEY=

# Without Supabase, production (`next start`, every Vercel deployment) refuses to start onboarding, because
# server memory isn't shared between instances. Set to true only for a single-instance demo.
ONBOARDING_ALLOW_MEMORY_STORE=

# ---- Walker API (server only) ----
# Claude (ANTHROPIC_API_KEY above) answers every walker turn, typed or spoken. Without it, turns get fixed lines.
# Optional main model override (empty: claude-haiku-5-5):
WALKER_AGENT_MODEL=
# The backup asked alongside it, used when the main model is slow (empty: claude-opus-5-5; "none": one model only).
WALKER_BACKUP_MODEL=
# Milliseconds the main model has before the backup's answer is used (empty: 4500).
WALKER_BACKUP_AFTER_MS=
# Cartesia transcribes Talk clips (speech-to-text) and gives Sophi's spoken voice. Empty (or "none"): a Talk press
# gets a fixed "can't hear you" line, and the walker speaks replies itself.
CARTESIA_API_KEY=
# Optional: another Cartesia stock voice id (never a cloned voice). Empty: "Skylar".
CARTESIA_VOICE_ID=
# Postgres for paired walkers. On Render it comes from the Blueprint's database (render.yaml). Empty: an
# in-memory store for local runs, and in production (such as Vercel) the walker routes answer 503.
DATABASE_URL=

# ---- Mock purchase, Stripe TEST MODE ONLY (server only) ----
# Must be a test secret key (sk_test_…) from the Stripe dashboard's test mode. Live (sk_live_, rk_live_) and
# restricted keys are refused, logged, and leave the button off. Empty = mock purchase off. No publishable key.
STRIPE_SECRET_KEY=

# ---- Vercel build only (set in the Vercel project, not in .env.local) ----
# 1 makes Vercel install with the pnpm version in the root package.json "packageManager" field.
ENABLE_EXPERIMENTAL_COREPACK=

# ---- Local sign-in testing (not a variable) ----
# With the local stack, sign in as walker-tester@example.test. The .test domain can't receive mail, and
# the local stack never sends any: read the code and link in Mailpit at http://127.0.0.1:55424.

# The care circle in SpacetimeDB (services/care-db/README.md). Set all four or none; with none, the circle stays in
# the walker store above. SPACETIME_JWT_PRIVATE_KEY is a secret: make it with `node scripts/care-db.mjs keygen --out <file>`.
SPACETIME_URI=
SPACETIME_DATABASE=
SPACETIME_ISSUER=
SPACETIME_JWT_PRIVATE_KEY=
