# Copy to .env.local (git-ignored) and fill in. Names only here: never commit a value.
# On Vercel, set the same names under Project Settings > Environment Variables (see README.md).

# ---- Onboarding engine (server only) ----
# deterministic (default) or agent. "agent" needs ANTHROPIC_API_KEY; without a key the deterministic engine runs.
ONBOARDING_ENGINE=deterministic
ANTHROPIC_API_KEY=
# Optional model override for the agent. Leave empty for the default in services/cloud-api/src/onboarding/anthropic.ts.
ONBOARDING_AGENT_MODEL=

# ---- Supabase (sessions in Postgres) ----
# Set all three, or none for the in-memory demo store. Some but not all stops onboarding from starting.
# Local values: `pnpm supabase start`, then `pnpm supabase status` prints API_URL, PUBLISHABLE_KEY and SECRET_KEY.
# Hosted values: the Supabase dashboard, Project Settings > API Keys.
# Project URL. Public: also sent to the browser.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…, or the legacy anon key). Public: row-level security is what protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…, or the legacy service_role key). Server only, never NEXT_PUBLIC_: it bypasses
# row-level security. Used only to reach demo sessions by their token hash.
SUPABASE_SECRET_KEY=

# Without Supabase, production (`next start`, every Vercel deployment) refuses to start onboarding, because
# server memory isn't shared between instances. Set to true only for a single-instance demo.
ONBOARDING_ALLOW_MEMORY_STORE=
