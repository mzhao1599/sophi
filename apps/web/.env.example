# Copy to .env.local (git-ignored) and fill in. Read by the server only; never exposed to the browser.

# deterministic (default) or agent. "agent" needs ANTHROPIC_API_KEY; without a key the deterministic engine runs.
ONBOARDING_ENGINE=deterministic
ANTHROPIC_API_KEY=
# Optional model override for the agent. Leave empty for the default in services/cloud-api/src/onboarding/anthropic.ts.
ONBOARDING_AGENT_MODEL=
