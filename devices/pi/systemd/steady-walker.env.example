# /etc/steady-walker.env: device names and pins for Steady's walker service. Only WALKER_GPIOMON has been
# checked on a Pi (2026-10-24); the ALSA names and pins below are still examples.
# Find the ALSA names with `arecord -L` and `aplay -L` (devices/pi/README.md, step 5). Prefer CARD= names,
# which survive replugging, over card numbers.
WALKER_ALSA_CAPTURE=plughw:CARD=Device,DEV=0
# A `default:CARD=...` playback name goes through ALSA's mixer, so a cue sound can play over speech.
WALKER_ALSA_PLAYBACK=default:CARD=Soundbar

# Optional Piper voice model. Without it (or if Piper fails) the walker speaks with espeak-ng.
#WALKER_PIPER_MODEL=/opt/steady-walker/voices/en_US-lessac-medium.onnx

# GPIO buttons, each wired from the pin to ground (README step 3). Line numbers are BCM GPIO numbers.
# The Pi can't sense a button, so it watches and reports them only when you say they're wired:
#WALKER_GPIO_BUTTONS=wired
WALKER_GPIO_CHIP=gpiochip0
WALKER_GPIO_TALK=17
WALKER_GPIO_CONFIRM=27
# libgpiod's command-line version (`gpiomon --version`): v2 on the current Raspberry Pi OS, trixie (2.2.1,
# checked on the Pi 5 on 2026-10-24); v1 on the older Bookworm (1.6.x).
WALKER_GPIOMON=v2
